{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zzzzzerozzzz/neo-char-brief/skins.schema.json",
  "title": "NEO 2D character skins (v4 aligned)",
  "description": "Canonical skin schema for the NEO 2D half-body rig. Field names are aligned to the shipped v4 rig.js (zip build, 2026-11-24). Earlier draft names (cBody/cHair/cPants/cShoe/cSkin2) are deprecated — see STATUS-v4.md §3.",
  "type": "array",
  "minItems": 6,
  "maxItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id", "name", "slot", "species", "earType", "tailType", "accessory",
      "bodyW", "bodyH", "headScale", "eyeGap", "eyeY", "eyeR", "mouthY",
      "blush", "whiskers", "muzzle",
      "cFur", "cFur2", "cSkin", "cShirt", "cShirt2", "cAccent",
      "cEye", "cNose", "cLine", "turnDefault"
    ],
    "properties": {
      "id":        { "type": "string", "pattern": "^[a-z]+-[0-9]{2}$" },
      "name":      { "type": "string", "minLength": 1, "maxLength": 12 },
      "slot":      { "enum": ["core", "support"] },
      "species":   { "enum": ["cat", "dog", "human"] },
      "earType":   { "enum": ["pointy", "round", "flop", "none"] },
      "tailType":  { "enum": ["curl", "curly", "straight", "fluffy", "none"] },
      "accessory": { "enum": ["glasses", "headset", "scarf", "none"] },
      "bodyW":     { "type": "number", "minimum": 0.7, "maximum": 1.4 },
      "bodyH":     { "type": "number", "minimum": 0.7, "maximum": 1.3 },
      "headScale": { "type": "number", "minimum": 0.7, "maximum": 1.3 },
      "eyeGap":    { "type": "number", "minimum": 50, "maximum": 110 },
      "eyeY":      { "type": "number", "minimum": -110, "maximum": -20 },
      "eyeR":      { "type": "number", "minimum": 16, "maximum": 36 },
      "mouthY":    { "type": "number", "minimum": 0, "maximum": 40 },
      "blush":     { "type": "number", "minimum": 0, "maximum": 1 },
      "whiskers":  { "type": "boolean" },
      "muzzle":    { "enum": ["none", "small", "wide"] },
      "cFur":      { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cFur2":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cSkin":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cShirt":    { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cShirt2":   { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cAccent":   { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cEye":      { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cNose":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "cLine":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "turnDefault": { "type": "number", "minimum": 0, "maximum": 1 },
      "notes":     { "type": "string", "maxLength": 60 }
    }
  }
}
